# Credenciales de Supabase para el frontend.
# Vite solo expone variables con prefijo VITE_ al navegador.
# Obtené estos valores en:
#   https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# NOTA: la service_role key NUNCA va en el frontend.
# Se configura como secreto en la Edge Function (admin-create-user).
